# Copy this file to .env and configure your LLM endpoint.
#
# You can use any OpenAI-compatible API endpoint:
# - Workshop endpoint (key provided at the workshop)
# - OpenAI: https://api.openai.com/v1/chat/completions
# - Azure OpenAI: https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions
# - Local Ollama: http://localhost:11434/v1/chat/completions
# - Any other OpenAI-compatible API
#
MAVAI_LLM_ENDPOINT=https://api.infomaniak.com/2/ai/113430/openai/v1/chat/completions
MAVAI_LLM_API_KEY=
