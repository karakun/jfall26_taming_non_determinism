# Copy this file to .env and configure your LLM endpoint.
#
# RECOMMENDED: Use your own LLM provider for best performance.
# The workshop API key is shared by all participants and may experience
# rate limiting or slower responses during peak usage.
#
# Supported OpenAI-compatible endpoints:
# - OpenAI: https://api.openai.com/v1/chat/completions
# - Azure OpenAI: https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions
# - Local Ollama: http://localhost:11434/v1/chat/completions (no key required)
# - Any other OpenAI-compatible API
#
# FALLBACK: If you don't have your own provider, use the workshop endpoint below
# with the API key provided at the workshop.
#
MAVAI_LLM_ENDPOINT=https://api.infomaniak.com/2/ai/113430/openai/v1/chat/completions
MAVAI_LLM_API_KEY=
